{
  "extends": "@vllnt/typescript/node-library.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    // On by default since @vllnt/typescript 3. It needs source changes in the
    // Convex handlers and can change emitted declarations, so adopting it is a
    // separate, reviewed change.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
